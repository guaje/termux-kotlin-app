<?xml version="1.0" encoding="utf-8"?>
<!--
  The manifest needs resources, not literals: android:description on <permission> is declared as a
  reference, and AAPT rejects a plain string with "'…' is incompatible with attribute description
  (attr) reference". Labels go in here too so the user-visible names are in one place, which is also
  where a translation would go.
-->
<resources>
    <string name="anchor_app_name">Termux Anchor</string>
    <string name="anchor_control_label">Talk to the Termux supervisor anchor</string>
    <string name="anchor_control_description">Allows a Termux build signed with the same key as this app to report that it is alive and to ask for a supervised restart.</string>
    <string name="anchor_heartbeat_label">Termux heartbeat</string>
    <string name="anchor_boot_label">Anchor boot watchdog</string>
</resources>
