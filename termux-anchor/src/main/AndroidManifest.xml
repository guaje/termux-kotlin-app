<?xml version="1.0" encoding="utf-8"?>
<!--
  The supervisor anchor.

  A second APK (com.termux.anchor) with its own uid, installed once, whose only job is to notice that
  com.termux has stopped reporting and bring it back. It installs nothing and updates nothing: the
  app already replaces itself through the devkit endpoint (app/src/main/kotlin/com/termux/app/devkit/
  DevKitShipCoordinator.kt), and a supervisor that could rewrite what it supervises is not a
  supervisor.

  Deliberately absent from this manifest:

  * android:sharedUserId. The app declares sharedUserId="com.termux" for itself; copying that here
    would put the anchor in the same uid, and the kill that a package replace performs is
    uid/cgroup-scoped (ProcessList.killProcessGroup(uid)), not process-tree-scoped. Measured on the
    handset (MEMORY.md §16C): a setsid marker reparented to PID 1 was swept along with its parent
    within 1-2 s of the install, with ~5 s of downtime before the app came back. Same uid means dying
    with the app, which is the entire thing this APK exists to avoid.
  * REQUEST_INSTALL_PACKAGES. The anchor never installs anything, so it does not ask for the right
    whose absence the app's dev manifest has to explain at length.
  * android:process, GCM, sync providers, backup rules, deep links. Nothing here is reachable from
    outside except the heartbeat and the boot signal.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The anchor is only useful across a reboot, since a reboot is one of the ways the app stays
         down. BOOT_COMPLETED is the only way to learn about that from inside an app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- The supervisor is a foreground service, because the alternative is that the ROM's sleep
         policy reaps the loop while the user is asleep, which is when the app most plausibly died. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Required separately from Android 14 for foregroundServiceType="specialUse" below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Enforced from Android 13. The channel is IMPORTANCE_LOW, so this is a visible notification
         the user can dismiss the anchor's ability to show at any time, not a nagging one. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- This is used only to put up the short rescue window that makes a background launch eligible
         and gives the user a rescue tap, never to draw over them for any other reason. The user can
         grant or revoke it in Settings; without it the anchor must still work by notifying, and the
         notification's user-initiated tap remains the way back. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
      The authentication for the whole design, in one line. protectionLevel="signature" means the
      platform grants this permission to a caller whose APK is signed with the same certificate as
      this one, and nothing else: no runtime prompt, no user tap to revoke, no token to leak. Both
      APKs are built from this repository and signed by the same release key, which is the only
      reason the app may send com.termux.anchor.HEARTBEAT at all - and the reason gradle/
      release-signing.gradle is shared instead of duplicated.

      There is no nonce and no self-declared identity in the payload because there is no untrusted
      sender to authenticate: a different signing key cannot reach the receiver, and the same key is
      this package's own lineage.
    -->
    <!-- The strings live in res/values/strings.xml: android:description on a <permission> is a
         reference attribute, so a literal here fails resource linking outright. -->
    <permission
        android:name="com.termux.anchor.permission.CONTROL"
        android:description="@string/anchor_control_description"
        android:label="@string/anchor_control_label"
        android:protectionLevel="signature" />

    <!--
      Package visibility, Android 11+. Without this block the anchor runs in a filtered view of the
      installed packages, packageManager.getLaunchIntentForPackage("com.termux") returns null, and the
      anchor reports "Termux is not installed" on a phone where it plainly is - broken while doing
      nothing wrong. One exact <package> entry rather than QUERY_ALL_PACKAGES, which Play treats as a
      red flag and which would let this APK enumerate the user's other apps.
    -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="@string/anchor_app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- The status screen: what the anchor last saw, how many restarts it has attempted, and the
             user's own switch. Launcher-visible because the user has to be able to open it to enable
             supervision, and because "why is there a notification from this" needs an answer. -->
        <activity
            android:name=".AnchorActivity"
            android:exported="true"
            android:label="@string/anchor_app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          exported="true" is unavoidable: the sender is another package, so this is by definition a
          cross-application component. It is guarded by the signature permission above instead, which
          is what makes the export harmless. Without android:permission an exported receiver would
          accept heartbeats from any app on the device, and a fake heartbeat would suppress every
          restart - the anchor's failure mode with the least evidence.
        -->
        <receiver
            android:name=".HeartbeatReceiver"
            android:exported="true"
            android:label="@string/anchor_heartbeat_label"
            android:permission="com.termux.anchor.permission.CONTROL">
            <intent-filter>
                <action android:name="com.termux.anchor.HEARTBEAT" />
            </intent-filter>
        </receiver>

        <!--
          exported="true" only because Android requires it: BOOT_COMPLETED is delivered by the system
          to components that are exported, and a non-exported receiver never hears it. The sender is
          the platform, so there is no permission to require here beyond that fact.
        -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:label="@string/anchor_boot_label">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!--
          specialUse rather than dataSync: what this service does is watch another package and relaunch
          it, which is not one of the typed categories, and declaring a type the platform does not have
          is how an app ends up unable to start a foreground service at all on Android 14+. The
          PROPERTY_SPECIAL_USE_FGS_SUBTYPE value below is the string a reviewer (and Play's scanner)
          reads in place of a type, and it is the same shape the app uses for its own services.
        -->
        <!--
          exported="true" only so that com.termux can keep this service alive, which is the only path
          measured to work. The anchor cannot revive itself from a heartbeat: after its own process dies -
          an update, a kill, the OEM battery manager - every start requested from the heartbeat receiver is
          refused, and the platform said so at the beat cadence while the app kept reporting to a receiver
          that was writing state into a supervision nobody was reading:

            W ActivityManager: Foreground service started from background can not have
              location/camera/microphone access: service com.termux.anchor/.AnchorSupervisorService

          Measured on the razr fold 2026 / Android 16 after installing this module over itself: five beats,
          five refusals, and `pidof com.termux.anchor` empty the whole time, so supervision had stopped
          existing while the anchor looked healthy from the outside. The supervised app is the one that is
          alive and often visible, so it is the one allowed to make this call; the signature permission means
          only it can, and com.termux already holds it. Without the grant or the ability to start, BOOT_COMPLETED
          is meant to be the remaining route, but it did not produce a running supervisor on the handset:
          25 s after a reboot `pidof com.termux.anchor` was still empty, and supervision came back 5 s after
          the user opened Termux, because that is when this app's beat started asking again. BOOT_COMPLETED
          is therefore best read as a chance to restore state, not as a guarantee of supervision; after a
          reboot with Termux never opened, nothing is watching.
        -->
        <service
            android:name=".AnchorSupervisorService"
            android:exported="true"
            android:permission="com.termux.anchor.permission.CONTROL"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="termux-supervisor" />
        </service>

    </application>

</manifest>
